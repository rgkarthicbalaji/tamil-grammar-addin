<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tamil Grammar Checker — Word add-in manifest.
  Hosted at https://rgkarthicbalaji.github.io/tamil-grammar-addin
  To install: Word → Insert → Add-ins → Upload My Add-in → choose this file.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>6f0c8f4e-2b7a-4d61-9a3e-5c1b7d2e9a41</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Tamil Grammar Checker</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Tamil Grammar Checker"/>
  <Description DefaultValue="Checks Tamil spelling, sandhi (புணர்ச்சி), agreement and style in Word documents."/>
  <IconUrl DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/taskpane/help.html"/>
  <AppDomains>
    <AppDomain>https://rgkarthicbalaji.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/taskpane/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="TG.Group">
                <Label resid="TG.GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TG.TaskpaneButton">
                  <Label resid="TG.ButtonLabel"/>
                  <Supertip>
                    <Title resid="TG.ButtonLabel"/>
                    <Description resid="TG.ButtonTooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>TamilGrammarPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/taskpane/help.html"/>
        <bt:Url id="Commands.Url" DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/taskpane/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://rgkarthicbalaji.github.io/tamil-grammar-addin/taskpane/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Tamil Grammar Checker is ready"/>
        <bt:String id="TG.GroupLabel" DefaultValue="Tamil"/>
        <bt:String id="TG.ButtonLabel" DefaultValue="Tamil Grammar"/>
        <!-- used by the underline pop-ups (Word.CritiquePopupOptions) -->
        <bt:String id="TG.Brand" DefaultValue="Tamil Grammar"/>
        <bt:String id="TG.PopupTitle" DefaultValue="இலக்கணப் பிழை"/>
        <bt:String id="TG.PopupSubtitle" DefaultValue="Suggested correction"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open Home > Tamil Grammar and press Check to find Tamil grammar errors."/>
        <bt:String id="TG.ButtonTooltip" DefaultValue="Check Tamil spelling, sandhi, agreement and style."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
